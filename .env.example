# Run make setup to generate .env with persistent identities and local credentials.
COMPOSE_PROJECT_NAME=ecommerce-analytics
DATASET_PATH=./Dataset/retailrocket-recommender-system-dataset
KAFKA_IMAGE=apache/kafka:3.9.1@sha256:4ceccc577f03f51f6af8dbfda55194d0d892f4fa7913ffbded567ce3895622ed
MONGO_IMAGE=mongo:8.0@sha256:6657bf2413fefc5be649390318f5b4cd7328e982722f8ce2ac6dfa6f0a42cb03
KAFKA_CLUSTER_ID=__GENERATE__
HDFS_CLUSTER_ID=CID-ecommerce-analytics
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=__GENERATE__
MONGO_DATABASE=ecommerce
MONGO_USERNAME=analytics
MONGO_PASSWORD=__GENERATE__
KAFKA_HOST_PORT=19092
MONGO_HOST_PORT=27018
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=18080
SPARK_WORKER_1_UI_PORT=18081
SPARK_WORKER_2_UI_PORT=18082
SPARK_APPLICATION_UI_PORT=14040
# Preflight needs 7 GiB available; container limits including init total less than 7 GiB.
MIN_AVAILABLE_RAM_GIB=7
MIN_DOCKER_DISK_GIB=30
# Optional host API port; the HTML dashboard opens with VS Code Live Server.
# API_HOST_PORT=8000
